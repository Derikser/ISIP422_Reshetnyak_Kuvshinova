<Window x:Class="ISIP422_Reshetnyak_Kuvshinova.MainWindow"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Учёт товаров в магазине" Height="550" Width="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель поиска -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="10" VerticalAlignment="Center">
            <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="0,0,10,0" Padding="5"/>
            <Button Content="Найти" Command="{Binding SearchProductsCommand}" Padding="10,5"/>
        </StackPanel>

        <!-- Панель кнопок -->
        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="10">
            <Button Content="Добавить товар" Command="{Binding AddProductCommand}" Margin="0,0,10,0" Padding="10,5"/>
            <Button Content="Удалить товар" Command="{Binding DeleteProductCommand}" Margin="0,0,10,0" Padding="10,5"/>
            <Button Content="Поставка (+10)" Command="{Binding SupplyProductCommand}" Margin="0,0,10,0" Padding="10,5" Background="LightGreen"/>
            <Button Content="Продажа (-1)" Command="{Binding SellProductCommand}" Margin="0,0,10,0" Padding="10,5" Background="LightCoral"/>
            <Button Content="Отменить продажу" Command="{Binding UndoLastSaleCommand}" Margin="0,0,10,0" Padding="10,5" Background="LightYellow"/>
            <Button Content="Отчёт о продажах" Command="{Binding ShowSalesReportCommand}" Padding="10,5" Background="LightBlue"/>
        </StackPanel>

        <!-- Список товаров -->
        <ListView ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" Grid.Row="2" Margin="10">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Код" DisplayMemberBinding="{Binding Id}" Width="60"/>
                    <GridViewColumn Header="Название" DisplayMemberBinding="{Binding Name}" Width="150"/>
                    <GridViewColumn Header="Цена" DisplayMemberBinding="{Binding Price, StringFormat={}{0:C}}" Width="80"/>
                    <GridViewColumn Header="Количество" DisplayMemberBinding="{Binding Quantity}" Width="80"/>
                    <GridViewColumn Header="В наличии" DisplayMemberBinding="{Binding IsInStock}" Width="80"/>
                    <GridViewColumn Header="Категория" DisplayMemberBinding="{Binding Category}" Width="100"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Window>