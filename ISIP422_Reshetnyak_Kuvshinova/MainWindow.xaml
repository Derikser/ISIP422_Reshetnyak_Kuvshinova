<Window x:Class="ISIP422_Reshetnyak_Kuvshinova.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Учёт товаров в магазине" Height="450" Width="800">
    <Grid>
        <ListView ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" Margin="10">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Код" DisplayMemberBinding="{Binding Id}" Width="60"/>
                    <GridViewColumn Header="Название" DisplayMemberBinding="{Binding Name}" Width="150"/>
                    <GridViewColumn Header="Цена" DisplayMemberBinding="{Binding Price}" Width="80"/>
                    <GridViewColumn Header="Количество" DisplayMemberBinding="{Binding Quantity}" Width="80"/>
                    <GridViewColumn Header="В наличии" DisplayMemberBinding="{Binding IsInStock}" Width="80"/>
                    <GridViewColumn Header="Категория" DisplayMemberBinding="{Binding Category}" Width="100"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Window>